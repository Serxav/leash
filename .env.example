# PayPal (sandbox only)
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Public Merchant ID of the sandbox Business account (for FraudNet risk data)
PAYPAL_MERCHANT_ID=

# AI: meta (Meta Model API, D-043). anthropic is still supported but not used.
AI_PROVIDER=meta
META_MODEL_API_KEY=
ANTHROPIC_API_KEY=

# Product catalog (optional: without it, Leash uses its local catalog)
CHANNEL3_API_KEY=

# Optional: the app's public address, for PayPal's return URL. On Render it
# defaults to RENDER_EXTERNAL_URL; in development, to localhost.
APP_URL=
